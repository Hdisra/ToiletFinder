# Backend base URL.
# iOS simulator:      http://localhost:3000/api
# Android emulator:   http://10.0.2.2:3000/api
# Physical device:    http://<your-computer-LAN-IP>:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Optional, only for development/production builds (not needed in Expo Go).
# Google Maps keys: see README. Leave empty to use the defaults.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
# Set to true only in an iOS development build with a Google Maps key.
EXPO_PUBLIC_IOS_GOOGLE_MAPS=false
