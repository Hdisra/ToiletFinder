PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=bathroomfinder
DB_PASSWORD=bathroomfinder
DB_NAME=bathroomfinder
# Creates/updates tables automatically. Development only.
DB_SYNCHRONIZE=true

# Signs login tokens and hashes reset codes. Use a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me
# How long a login lasts.
JWT_EXPIRES_IN=30d

# Outgoing email (password reset codes). Locally, Mailpit catches them: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Toilet Finder <no-reply@toiletfinder.local>"

# Production only: how many reverse proxies (nginx, a load balancer...) are in front of the
# app, usually 1. Needed so the rate limits use the real client IP. Leave empty if none.
TRUST_PROXY_HOPS=

# Browser origin(s) allowed to call the API (the admin web app). Comma separated.
CORS_ORIGIN=http://localhost:5173

# Only used by `pnpm admin:create`, which creates (or promotes) the admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
